description: '''>-
  Delegates a Namecheap domain to a pair of custom nameservers in overwrite
  mode. The primary nameserver comes from an input so the update pass changes it
  in place, and destroy returns the domain to Namecheap's default DNS. This
  changes the domain's nameserver delegation, so run it only against a
  disposable test domain.
  '''

imports: { namecheap: 'github.com/cloudboss/unobin-library-namecheap' }

inputs: {
  domain: {
    type:        string
    description: 'The Namecheap domain to delegate'
  }
  primary-ns: {
    type:        optional(string, 'ns1.example.com')
    description: 'The primary custom nameserver; the update pass changes it'
  }
}

resources: {
  namecheap.domain-nameservers.it: {
    domain:      var.domain
    mode:        'OVERWRITE'
    nameservers: [var.primary-ns, 'ns2.example.com']
  }
}

outputs: {
  domain: { value: resource.namecheap.domain-nameservers.it.domain }
}
