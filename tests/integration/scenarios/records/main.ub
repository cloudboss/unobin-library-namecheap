description: '''>-
  Manages a set of host records on a Namecheap domain in overwrite mode: a www A
  record whose address comes from an input so the update pass changes it in
  place, and a txt TXT record. Overwrite owns the whole record set, so apply
  replaces the domain's records, the update pass changes the www address, and
  destroy clears them.
  '''

imports: { namecheap: 'github.com/cloudboss/unobin-library-namecheap' }

inputs: {
  domain: {
    type:        string
    description: 'The Namecheap domain to manage records for'
  }
  www-address: {
    type:        optional(string, '192.0.2.1')
    description: 'Address of the www A record; the update pass changes it'
  }
}

resources: {
  namecheap.domain-records.it: {
    domain: var.domain
    mode:   'OVERWRITE'
    records: [
      { hostname: 'www', type: 'A', address: var.www-address, ttl: 300 },
      { hostname: 'txt', type: 'TXT', address: 'hello from unobin', ttl: 300 },
    ]
  }
}

outputs: {
  domain: { value: resource.namecheap.domain-records.it.domain }
}
