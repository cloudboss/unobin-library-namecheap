{
  "name": "replacement",
  "factoryPath": "src",
  "libraryPath": "example.com/namecheap/replacement",
  "build": true,
  "commands": [
    {
      "name": "plan-create",
      "args": ["plan", "--ascii", "-c", "stacks/create/dev.ub", "-o", "create.ubp"],
      "stdout": "want/plan-create.stdout",
      "stderr": "want/notice.stderr"
    },
    {
      "name": "apply-create",
      "args": ["apply", "--parallelism", "1", "--format", "json", "create.ubp"],
      "stdout": "want/apply-create.stdout",
      "normalize": "json"
    },
    {
      "name": "plan-replace",
      "args": ["plan", "--ascii", "-c", "stacks/replace/dev.ub", "-o", "replace.ubp"],
      "stdout": "want/plan-replace.stdout",
      "stderr": "want/notice.stderr"
    },
    {
      "name": "apply-replace",
      "args": ["apply", "--parallelism", "1", "--format", "json", "replace.ubp"],
      "stdout": "want/apply-replace.stdout",
      "normalize": "json"
    },
    {
      "name": "plan-noop",
      "args": ["plan", "--ascii", "-c", "stacks/replace/dev.ub", "-o", "noop.ubp"],
      "stdout": "want/plan-noop.stdout",
      "stderr": "want/notice.stderr"
    }
  ]
}
